<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <StartupUri>App.xaml</StartupUri>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stego.GUI\Stego.GUI\Stego.GUI.csproj" />
    <ProjectReference Include="..\Stego.Core\Stego.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Stego.GUI\Stego.GUI\Languages\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Languages\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="..\Stego.GUI\Stego.GUI\Themes\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Themes\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
