<Window x:Class="Stego.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StegoSecure"
        Width="1120"
        Height="740"
        MinWidth="980"
        MinHeight="730"
        WindowStartupLocation="CenterScreen"
        Background= "{DynamicResource BodyBackground}">

    <Grid Margin="16">
        <TabControl Background="Transparent">
            <TabItem Header="{DynamicResource TabHideText}"
                Background="{DynamicResource SecondaryButtonBrush}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FBTitle}" Style="{DynamicResource SectionTitleStyle}"/>

                                <Grid Name="DropZoneEncode"
                                      Height="130"
                                      AllowDrop="True"
                                      Drop="DropZoneEncode_Drop"
                                      DragOver="DropZone_DragOver"
                                      Margin="0,0,0,10">
                                    <Border Background="{DynamicResource LargeBoxBackground}" CornerRadius="10"/>
                                    <Rectangle Stroke="{DynamicResource SelectImageBorder}"
                                               StrokeThickness="1.5"
                                               StrokeDashArray="6 4"
                                               RadiusX="10"
                                               RadiusY="10"
                                               Margin="1"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Name="EncodeDropText"
                                                   Text="{DynamicResource FBTip1}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SelectImageText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <Button Name="EncodeBrowseButton"
                                                Content="{DynamicResource FBButton}"
                                                Click="EncodeBrowseButton_Click"
                                                Style="{DynamicResource RoundedSecondaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource FBTip2}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TinyText}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{DynamicResource SB1Title}" Style="{DynamicResource SectionTitleStyle}"/>
                                <TextBox Grid.Row="1"
                                         Name="MessageInput"
                                         MinHeight="110"
                                         AcceptsReturn="True"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{DynamicResource RegularText}"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         BorderBrush="{DynamicResource BoxBorder}"
                                         BorderThickness="1"
                                         Padding="10"
                                         FontSize="14"/>
                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource SB1Tip}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TinyText}"
                                           Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TBTitle}" Style="{DynamicResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Name="OutputPathInput"
                                             Grid.Column="0"
                                             Height="38"
                                             Foreground="{DynamicResource RegularText}"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             BorderBrush="{DynamicResource BoxBorder}"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             Margin="0,0,10,0"
                                             FontSize="13"/>

                                    <Button Name="OutputBrowseButton"
                                            Grid.Column="1"
                                            Width="60"
                                            Content="{DynamicResource STBBrowse}"
                                            Click="OutputBrowseButton_Click"
                                            Style="{DynamicResource RoundedSecondaryButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="3"
                                Name="EncodeButton"
                                Content="{DynamicResource TBButtonBig}"
                                Click="EncodeButton_Click"
                                Height="48"
                                Margin="0,0,0,6"
                                Style="{DynamicResource RoundedPrimaryButtonStyle}"/>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{DynamicResource SPreview}" Style="{DynamicResource SectionTitleStyle}"/>
                                <Border Grid.Row="1"
                                        MinHeight="140"
                                        Background="{DynamicResource LargeBoxBackground}"
                                        BorderBrush="{DynamicResource PreviewBoxBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Image Name="EncodeImagePreview" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SFile}" Style="{DynamicResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SFormat}" Foreground="{DynamicResource TinyText}" Margin="0,0,10,8"/>
                                    <TextBlock Name="FileFormatValue" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="{DynamicResource RegularText}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SSize}" Foreground="{DynamicResource TinyText}" Margin="0,0,10,8"/>
                                    <TextBlock Name="FileSizeValue" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="{DynamicResource RegularText}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SDimensions}" Foreground="{DynamicResource TinyText}" Margin="0,0,10,0"/>
                                    <TextBlock Name="FileResolutionValue" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="{DynamicResource RegularText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource STip}" Style="{DynamicResource SectionTitleStyle}"/>
                                <TextBlock Text="{DynamicResource SSelectImage}" Margin="0,0,0,6" Foreground="{DynamicResource TipText}"/>
                                <TextBlock Text="{DynamicResource SEnterText}" Margin="0,0,0,6" Foreground="{DynamicResource TipText}"/>
                                <TextBlock Text="{DynamicResource SPressButton}" Margin="0,0,0,6" Foreground="{DynamicResource TipText}"/>
                                <TextBlock Text="{DynamicResource SSaveImage}" Foreground="{DynamicResource TipText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource TabShowText}" 
            Background="{DynamicResource SecondaryButtonBrush}" 
            Padding="6,2,6,2">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="0"
                          Grid.Row="0"
                          Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FBTitle}" Style="{DynamicResource SectionTitleStyle}"/>

                                <Grid Name="DropZoneDecode"
                                      Height="130"
                                      AllowDrop="True"
                                      Drop="DropZoneDecode_Drop"
                                      DragOver="DropZone_DragOver"
                                      Margin="0,0,0,10">
                                    <Border Background="{DynamicResource LargeBoxBackground}" CornerRadius="10"/>
                                    <Rectangle Stroke="{DynamicResource SelectImageBorder}"
                                               StrokeThickness="1.5"
                                               StrokeDashArray="6 4"
                                               RadiusX="10"
                                               RadiusY="10"
                                               Margin="1"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Name="DecodeDropText"
                                                   Text="{DynamicResource FBTip1}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SelectImageText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <Button Name="DecodeBrowseButton"
                                                Content="{DynamicResource FBButton}"
                                                Click="DecodeBrowseButton_Click"
                                                Style="{DynamicResource RoundedSecondaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource FBTip2}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TinyText}"/>
                            </StackPanel>
                        </Border>


                        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SB2Title}" Style="{DynamicResource SectionTitleStyle}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Name="DecodeOutputPathInput"
                                             Grid.Column="0"
                                             Height="38"
                                             Foreground="{DynamicResource RegularText}"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             BorderBrush="{DynamicResource BoxBorder}"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             Margin="0,0,10,0"
                                             FontSize="13"/>

                                    <!--here-->
                                    <Button Name="DecodeOutputBrowseButton"
                                            Grid.Column="1"                                            
                                            Width="60"
                                            Content="{DynamicResource STBBrowse}"
                                            Click="DecodeOutputBrowseButton_Click"
                                            Style="{DynamicResource RoundedSecondaryButtonStyle}"/>
                                </Grid>

                                <Button Name="SaveDecodedTextButton"
                                        Content="{DynamicResource SB2ButtonBig}"
                                        Click="SaveDecodedTextButton_Click"
                                        Height="40"
                                        IsEnabled="False"
                                        Style="{DynamicResource RoundedSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{DynamicResource SPreview}" Style="{DynamicResource SectionTitleStyle}"/>
                                <Border Grid.Row="1"
                                        MinHeight="120"
                                        Background="{DynamicResource LargeBoxBackground}"
                                        BorderBrush="{DynamicResource PreviewBoxBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Image Name="DecodeImagePreview" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SFile}" Style="{DynamicResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SFormat}" Foreground="{DynamicResource TinyText}" Margin="0,0,10,8"/>
                                    <TextBlock Name="DecodeFileFormatValue" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="{DynamicResource RegularText}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SSize}" Foreground="{DynamicResource TinyText}" Margin="0,0,10,8"/>
                                    <TextBlock Name="DecodeFileSizeValue" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{DynamicResource RegularText}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SDimensions}" Foreground="{DynamicResource TinyText}" Margin="0,0,10,0"/>
                                    <TextBlock Name="DecodeFileResolutionValue" Grid.Row="2" Grid.Column="1" Text="-" Foreground="{DynamicResource RegularText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Style="{DynamicResource CardBorderStyle}"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RTitle}" Style="{DynamicResource SectionTitleStyle}"/>
                            <TextBox Name="DecodeResultText"
                                     Height="120"
                                     Text="{DynamicResource RTextBox}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{DynamicResource RegularText}"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource BoxBorder}"
                                     BorderThickness="1"
                                     Padding="10"
                                     FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid>
            <StackPanel Orientation="Horizontal" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Top" Margin="0,1,0,0">

                <ComboBox x:Name="ThemeCombo" 
                IsEditable="True" 
                IsReadOnly="True"
                Text="{DynamicResource Theme}"
                Background="{DynamicResource BodyBackground}"
                Foreground="{DynamicResource RegularText}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Height="22"
                Margin="0,0,10,0" 
                SelectionChanged="ThemeCombo_SelectionChanged" 
                DropDownOpened="ThemeCombo_DropDownOpened">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Gd" Background="Transparent" Padding="4,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Gd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>

                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#ACACAC" 
                                BorderThickness="1" 
                                CornerRadius="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="PART_EditableTextBox" 
                                         Background="Transparent" 
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         Foreground="{TemplateBinding Foreground}" 
                                         BorderThickness="0" 
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         VerticalContentAlignment="Center"
                                         Margin="3,0"/>

                                        <!-- The Arrow Button -->
                                        <ToggleButton Grid.Column="1" 
                                          Background="Transparent" 
                                          Foreground ="{DynamicResource RegularText}"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <!-- The Border acts as the hit-test area for the mouse -->
                                                    <Border Background="{TemplateBinding Background}">
                                                        <Path x:Name="ArrowPath" 
                                                          Data="M 0 0 L 4 4 L 8 0 Z" 
                                                          Fill="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" 
                                                          Width="12"
                                                          Height="8" 
                                                          Stretch="Fill"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ArrowPath" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- The actual dropdown list -->
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                                    <Border x:Name="ItemBorder" 
                                    Background="{DynamicResource BodyBackground}" 
                                    SnapsToDevicePixels="True"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    BorderBrush="{DynamicResource RegularText}" 
                                    BorderThickness="1">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>
                    <!--item container jiblets-->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBackgroundBorder" 
                                        Background="Transparent" 
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBackgroundBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <!-- Outer Rectangle (secondary BG) -->
                                <Border 
                                Height="25"
                                Background="{Binding secondaryBG}"
                                BorderThickness="1">

                                    <!-- Middle Rectangle (primary BG) -->
                                    <Border
                                    Background="{Binding primaryBG}"
                                    Margin="10, 4" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch">

                                        <!-- Inner Rectangle (Text Color) -->
                                        <Rectangle
                                        Fill="{Binding textColor}"
                                        Margin="10, 4" 
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="LanguageCombo" 
                IsEditable="True" 
                IsReadOnly="True"
                Text="{DynamicResource Language}"
                Background="{DynamicResource BodyBackground}"
                Foreground="{DynamicResource RegularText}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Height="22"
                Margin="0,0,0,0" 
                SelectionChanged="LanguageCombo_SelectionChanged" 
                DropDownOpened="LanguageCombo_DropDownOpened">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Gd" Background="Transparent" Padding="4,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Gd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>

                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#ACACAC" 
                                BorderThickness="1" 
                                CornerRadius="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="PART_EditableTextBox" 
                                         Background="Transparent" 
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         Foreground="{TemplateBinding Foreground}" 
                                         BorderThickness="0" 
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         VerticalContentAlignment="Center"
                                         Margin="3,0"/>

                                        <!-- The Arrow Button -->
                                        <ToggleButton Grid.Column="1" 
                                          Background="Transparent" 
                                          Foreground ="{DynamicResource RegularText}"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <!-- The Border acts as the hit-test area for the mouse -->
                                                    <Border Background="{TemplateBinding Background}">
                                                        <Path x:Name="ArrowPath" 
                                                          Data="M 0 0 L 4 4 L 8 0 Z" 
                                                          Fill="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" 
                                                          Width="12"
                                                          Height="8" 
                                                          Stretch="Fill"/>  
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ArrowPath" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- The actual dropdown list -->
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                                    <Border x:Name="ItemBorder" 
                                    SnapsToDevicePixels="True"
                                    Background="{DynamicResource BodyBackground}" 
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    BorderBrush="{DynamicResource RegularText}" 
                                    BorderThickness="1">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>
                </ComboBox>

            </StackPanel>
        </Grid>
    </Grid>
</Window>